<%- include('../partials/header') %>
<div class="page-head">
  <a class="back" href="/import" aria-label="Back"><%- icon('back') %></a>
  <h1>Check import</h1>
  <div class="sub"><%= filename %></div>
</div>

<div class="stats">
  <div class="stat hero"><div class="label">Ready to import</div><div class="value"><%= ready %></div><div class="hint">of <%= rows.length %> rows</div></div>
  <div class="stat"><div class="label">Problems</div><div class="value <%= errors ? 'bad' : '' %>"><%= errors %></div><div class="hint">Skipped</div></div>
  <div class="stat"><div class="label">Duplicates</div><div class="value"><%= duplicates %></div><div class="hint">Skipped</div></div>
</div>

<% if (ready) { %>
<form method="post" action="/import/confirm" style="margin-bottom:20px">
  <button class="btn primary big" type="submit">Import <%= ready %> student<%= ready === 1 ? '' : 's' %></button>
  <% if (errors) { %><span class="small muted" style="margin-left:8px">Or fix the file and upload again.</span><% } %>
</form>
<% } else { %>
  <div class="flash error">Nothing can be imported. Fix the problems below and upload again.</div>
<% } %>

<div class="card flush">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Row</th><th>Name</th><th>Class</th><th>Parent</th><th>Phone</th><th>Joined</th><th>Status</th></tr></thead>
      <tbody>
      <% for (const r of rows) { %>
        <tr>
          <td class="muted"><%= r.line %></td>
          <td><%= r.name || '—' %></td>
          <td><%= r.label || '—' %></td>
          <td><%= r.parent_name || '' %></td>
          <td><%= r.phone || '' %></td>
          <td><%= r.join_date ? dates.dateLabel(r.join_date) : '' %></td>
          <td style="white-space:normal">
            <% if (r.status === 'ok') { %><span class="badge good">Ready</span>
            <% } else { %><span class="badge <%= r.status === 'error' ? 'bad' : 'warn' %>"><%= r.problems.join('; ') %></span><% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
