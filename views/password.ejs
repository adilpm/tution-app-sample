<%- include('partials/header') %>
<div class="page-head"><a class="back" href="/more" aria-label="Back"><%- icon('back') %></a><h1>Change password</h1></div>
<div class="card" style="max-width:480px">
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/account/password">
    <div class="field"><label for="current">Current password</label><input type="password" id="current" name="current" autocomplete="current-password" required></div>
    <div class="field"><label for="password">New password</label><input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required><div class="help">At least 8 characters.</div></div>
    <div class="field"><label for="confirm">Repeat new password</label><input type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="8" required></div>
    <button class="btn primary block" type="submit">Change password</button>
  </form>
</div>
<%- include('partials/footer') %>
